# Copy to .env and fill in. .env is gitignored — never commit keys.
ELEVENLABS_API_KEY=
API_FOOTBALL_KEY=
TMS_DEFAULT_VOICE_ID=
TMS_BROWSER_EXECUTABLE=
TMS_PROJECTS_DIR=
TMS_MAX_TTS_CHARS=6000
TMS_MAX_MUSIC_SECONDS=200
TMS_MAX_API_FOOTBALL_CALLS_PER_PROJECT=40
# Optional: route ElevenLabs / API-Football calls through a proxy (e.g. a local VPN client: http://127.0.0.1:10809)
TMS_HTTPS_PROXY=
