{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tms.local/schemas/artifacts/timeline.schema.json",
  "title": "timeline — master clock in integer frames @30fps / 48kHz (1600 samples per frame)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project_id", "inputs", "fps", "sr", "frames", "intro", "outro", "scenes", "vo", "words", "anchors", "captions", "duck"],
  "properties": {
    "version": {"$ref": "../defs.schema.json#/$defs/version"},
    "project_id": {"$ref": "../defs.schema.json#/$defs/slug"},
    "inputs": {"$ref": "../defs.schema.json#/$defs/inputs"},
    "fps": {"const": 30},
    "sr": {"const": 48000},
    "frames": {"type": "integer", "minimum": 1},
    "intro": {"$ref": "#/$defs/span"},
    "outro": {"$ref": "#/$defs/span"},
    "scenes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "from", "to", "vo", "warp"],
        "properties": {
          "id": {"type": "string", "pattern": "^S\\d{2}$"},
          "from": {"type": "integer", "minimum": 0}, "to": {"type": "integer", "minimum": 0},
          "vo": {"type": ["string", "null"]},
          "warp": {
            "description": "piecewise-linear knots [tau_seconds, frame_offset]; a repeated tau is a hold",
            "type": "array", "minItems": 2,
            "items": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "integer"}], "minItems": 2, "maxItems": 2}
          }
        }
      }
    },
    "vo": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "scene", "from", "samples", "file"],
        "properties": {
          "id": {"type": "string"}, "scene": {"type": "string"},
          "from": {"type": "integer", "minimum": 0}, "samples": {"type": "integer", "minimum": 1},
          "file": {"type": "string"}
        }
      }
    },
    "words": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["i", "clip", "display", "from", "to"],
        "properties": {
          "i": {"type": "integer"}, "clip": {"type": "string"}, "display": {"type": "string"},
          "from": {"type": "integer"}, "to": {"type": "integer"}
        }
      }
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["scene", "word", "ref", "word_frame", "event_frame", "err"],
        "properties": {
          "scene": {"type": "string"}, "word": {"type": "integer"}, "ref": {"type": "string"},
          "word_frame": {"type": "integer"}, "event_frame": {"type": "integer"}, "err": {"type": "integer"}
        }
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "from", "to", "lines", "words", "place"],
        "properties": {
          "id": {"type": "string"}, "from": {"type": "integer"}, "to": {"type": "integer"},
          "lines": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string", "maxLength": 42}},
          "words": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}], "minItems": 2, "maxItems": 2},
          "place": {"enum": ["bottom", "top"]}
        }
      }
    },
    "duck": {
      "type": "object", "additionalProperties": false, "required": ["windows", "depth_db", "attack_ms", "release_ms"],
      "properties": {
        "windows": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}], "minItems": 2, "maxItems": 2}},
        "depth_db": {"type": "number", "maximum": 0},
        "attack_ms": {"type": "number", "minimum": 0},
        "release_ms": {"type": "number", "minimum": 0}
      }
    }
  },
  "$defs": {
    "span": {
      "type": "object", "additionalProperties": false, "required": ["from", "to"],
      "properties": {"from": {"type": "integer", "minimum": 0}, "to": {"type": "integer", "minimum": 0}}
    }
  }
}
