{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tms.local/schemas/artifacts/render_props.schema.json",
  "title": "render_props — frame-indexed display list. Remotion draws it; it never computes motion or timing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project_id", "inputs", "fps", "width", "height", "durationInFrames", "orientation", "theme",
               "entities", "tracks", "camera", "pitchVisible", "freeze", "scenes", "overlays", "graphics", "captions",
               "titleCard", "endCard", "debug"],
  "properties": {
    "version": {"const": "1"},
    "project_id": {"type": "string"},
    "inputs": {"type": "object", "additionalProperties": {"type": "string"}},
    "fps": {"const": 30},
    "width": {"enum": [1920, 1080, 960, 540]},
    "height": {"enum": [1080, 1920, 540, 960]},
    "durationInFrames": {"type": "integer", "minimum": 1},
    "orientation": {"enum": ["landscape", "portrait", "square"]},
    "theme": {
      "type": "object", "additionalProperties": false, "required": ["pitch", "teams", "accent", "warn", "ink", "panel"],
      "properties": {
        "pitch": {
          "type": "object", "additionalProperties": false, "required": ["grass", "stripe", "line"],
          "properties": {"grass": {"$ref": "#/$defs/hex"}, "stripe": {"$ref": "#/$defs/hex"}, "line": {"$ref": "#/$defs/hex"}}
        },
        "teams": {
          "type": "object", "additionalProperties": false, "required": ["H", "A"],
          "properties": {"H": {"$ref": "#/$defs/teamTheme"}, "A": {"$ref": "#/$defs/teamTheme"}}
        },
        "accent": {"$ref": "#/$defs/hex"},
        "warn": {"$ref": "#/$defs/hex"},
        "ink": {"$ref": "#/$defs/hex"},
        "panel": {"$ref": "#/$defs/hex"}
      }
    },
    "entities": {
      "type": "array", "maxItems": 22,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "team", "number", "label"],
        "properties": {
          "id": {"type": "string", "pattern": "^[HA](1[01]|[1-9])$"},
          "team": {"enum": ["H", "A"]},
          "number": {"type": "integer", "minimum": 1, "maximum": 99},
          "label": {"type": ["string", "null"], "maxLength": 18}
        }
      }
    },
    "tracks": {
      "type": "object", "additionalProperties": false, "required": ["unit", "players", "ball"],
      "properties": {
        "unit": {"const": "cm"},
        "players": {
          "description": "per entity: [x0,y0,x1,y1,...] one (x,y) per frame, centimetres, absolute pitch frame",
          "type": "object", "additionalProperties": {"type": "array", "items": {"type": "integer"}}
        },
        "ball": {"description": "[x,y,z] per frame, centimetres", "type": "array", "items": {"type": "integer"}}
      }
    },
    "camera": {"description": "[cx,cy,w] per frame, centimetres; w = visible extent along pitch x", "type": "array", "items": {"type": "integer"}},
    "pitchVisible": {"type": "array", "items": {"$ref": "#/$defs/span"}},
    "freeze": {"type": "array", "items": {"$ref": "#/$defs/span"}},
    "scenes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "kind", "from", "to", "title"],
        "properties": {
          "id": {"type": "string"}, "kind": {"enum": ["pitch", "graphic"]},
          "from": {"type": "integer", "minimum": 0}, "to": {"type": "integer", "minimum": 0},
          "title": {"type": "string", "maxLength": 28}
        }
      }
    },
    "overlays": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "kind", "from", "to", "inAnim", "outAnim", "geom", "style", "label"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["run_arrow", "pass_line", "zone", "line", "ring", "spotlight", "label", "distance", "polygon"]},
          "from": {"type": "integer", "minimum": 0}, "to": {"type": "integer", "minimum": 0},
          "inAnim": {"$ref": "#/$defs/anim"}, "outAnim": {"$ref": "#/$defs/anim"},
          "geom": {
            "oneOf": [
              {"type": "object", "additionalProperties": false, "required": ["static"],
               "properties": {"static": {"type": "array", "items": {"$ref": "#/$defs/pt"}}}},
              {"type": "object", "additionalProperties": false, "required": ["perFrame"],
               "properties": {"perFrame": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/pt"}}}}}
            ]
          },
          "style": {
            "type": "object", "additionalProperties": false, "required": ["color", "dash", "fill"],
            "properties": {
              "color": {"enum": ["accent", "warn", "H", "A", "ink"]},
              "dash": {"type": "boolean"}, "fill": {"type": "boolean"},
              "curved": {"type": "boolean"}
            }
          },
          "label": {"type": ["string", "null"], "maxLength": 28}
        }
      }
    },
    "graphics": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "template", "from", "to", "data", "reveals"],
        "properties": {
          "id": {"type": "string"},
          "template": {"enum": ["title_card", "text_card", "stat_compare", "form_guide", "h2h_strip", "lineup_board",
                                "team_news", "key_player_duel", "probability_bar", "scoreline_grid", "prediction_card", "pattern_compare"]},
          "from": {"type": "integer", "minimum": 0}, "to": {"type": "integer", "minimum": 0},
          "data": {"type": "object"},
          "reveals": {
            "type": "array",
            "items": {"type": "object", "additionalProperties": false, "required": ["id", "frame"],
                      "properties": {"id": {"type": "string"}, "frame": {"type": "integer", "minimum": 0}}}
          }
        }
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["from", "to", "lines", "words", "place"],
        "properties": {
          "from": {"type": "integer", "minimum": 0}, "to": {"type": "integer", "minimum": 0},
          "lines": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string", "maxLength": 42}},
          "words": {
            "type": "array",
            "items": {"type": "object", "additionalProperties": false, "required": ["t", "from", "to", "line"],
                      "properties": {"t": {"type": "string"}, "from": {"type": "integer"}, "to": {"type": "integer"}, "line": {"enum": [0, 1]}}}
          },
          "place": {"enum": ["bottom", "top"]}
        }
      }
    },
    "titleCard": {
      "anyOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["from", "to", "title", "subtitle"],
         "properties": {"from": {"type": "integer"}, "to": {"type": "integer"}, "title": {"type": "string"}, "subtitle": {"type": "string"}}}
      ]
    },
    "endCard": {
      "anyOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["from", "to", "text"],
         "properties": {"from": {"type": "integer"}, "to": {"type": "integer"}, "text": {"type": "string"}}}
      ]
    },
    "principleRail": {
      "description": "Key panel of the one-frame tactic still (never in a video): the whole principle titles and the players each one involves, beside the pitch so they cannot collide with it. rect = [x0,y0,x1,y1] in output px; the camera leaves that part of the frame free.",
      "type": "object", "additionalProperties": false, "required": ["rect", "title", "ball", "principles"],
      "properties": {
        "rect": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
        "title": {"type": "string"},
        "ball": {
          "type": "object", "additionalProperties": false, "required": ["team", "number", "name"],
          "properties": {
            "team": {"enum": ["H", "A"]},
            "number": {"type": "integer", "minimum": 1, "maximum": 99},
            "name": {"type": ["string", "null"]}
          }
        },
        "principles": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "name", "players"],
            "properties": {
              "id": {"type": "string"},
              "name": {"type": "string"},
              "players": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["team", "number"],
                  "properties": {
                    "team": {"enum": ["H", "A"]},
                    "number": {"type": "integer", "minimum": 1, "maximum": 99}
                  }
                }
              }
            }
          }
        }
      }
    },
    "debug": {
      "type": "object", "additionalProperties": false, "required": ["overlay"],
      "properties": {"overlay": {"type": "boolean"}}
    }
  },
  "$defs": {
    "hex": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
    "pt": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
    "span": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}], "minItems": 2, "maxItems": 2},
    "anim": {
      "type": "object", "additionalProperties": false, "required": ["anim", "frames"],
      "properties": {"anim": {"enum": ["draw", "fade", "pop", "none"]}, "frames": {"type": "integer", "minimum": 0, "maximum": 30}}
    },
    "teamTheme": {
      "type": "object", "additionalProperties": false, "required": ["fill", "ring", "text", "short", "name"],
      "properties": {
        "fill": {"$ref": "#/$defs/hex"}, "ring": {"$ref": "#/$defs/hex"}, "text": {"$ref": "#/$defs/hex"},
        "short": {"type": "string"}, "name": {"type": "string"},
        "crest": {"type": "string", "maxLength": 700000, "pattern": "^data:image/(png|svg\\+xml);base64,[A-Za-z0-9+/]+={0,2}$"}
      }
    }
  }
}
