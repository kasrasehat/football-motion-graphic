{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tms.local/schemas/artifacts/voiceover_manifest.schema.json",
  "title": "voiceover_manifest — one TTS clip per narrated scene, with word timings",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project_id", "inputs", "provider", "voice_id", "model_id", "clips", "chars_billed_total"],
  "properties": {
    "version": {"$ref": "../defs.schema.json#/$defs/version"},
    "project_id": {"$ref": "../defs.schema.json#/$defs/slug"},
    "inputs": {"$ref": "../defs.schema.json#/$defs/inputs"},
    "provider": {"enum": ["elevenlabs", "mock_flite"]},
    "voice_id": {"type": "string"},
    "model_id": {"type": "string"},
    "clips": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "scene", "text", "tts_text", "request_hash", "cached", "file", "sample_rate", "samples",
                     "duration_s", "onset_correction_s", "chars_billed", "words"],
        "properties": {
          "id": {"type": "string", "pattern": "^V\\d{2}$"},
          "scene": {"type": "string", "pattern": "^S\\d{2}$"},
          "text": {"type": "string", "minLength": 1},
          "tts_text": {"type": "string", "minLength": 1},
          "request_hash": {"$ref": "../defs.schema.json#/$defs/sha256"},
          "cached": {"type": "boolean"},
          "file": {"type": "string", "pattern": "^media/"},
          "sample_rate": {"const": 48000},
          "samples": {"type": "integer", "minimum": 1},
          "duration_s": {"type": "number", "exclusiveMinimum": 0},
          "onset_correction_s": {"type": "number"},
          "chars_billed": {"type": "integer", "minimum": 0},
          "words": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["i", "display", "spoken", "start_s", "end_s"],
              "properties": {
                "i": {"type": "integer", "minimum": 0}, "display": {"type": "string"}, "spoken": {"type": "string"},
                "start_s": {"type": "number", "minimum": 0}, "end_s": {"type": "number", "minimum": 0}
              }
            }
          }
        }
      }
    },
    "chars_billed_total": {"type": "integer", "minimum": 0}
  }
}
