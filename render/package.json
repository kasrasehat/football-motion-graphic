{
  "name": "tms-render",
  "private": true,
  "type": "module",
  "description": "Remotion renderer for Tactic Motion Studio. Pure function of (frame, render_props).",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "fonts": "node scripts/copy-fonts.mjs",
    "postinstall": "node scripts/copy-fonts.mjs",
    "gen:types": "node scripts/gen-types.mjs",
    "gen:types:check": "node scripts/gen-types.mjs --check",
    "sync:fixture": "node scripts/sync-fixture.mjs",
    "render": "node scripts/render.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run gen:types:check && npm run typecheck && npm run test",
    "verify:fast": "npm run typecheck"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.536",
    "@remotion/cli": "4.0.536",
    "@remotion/fonts": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "ajv": "8.20.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
